# Variables de serveur uniquement. Copier dans .env.local et renseigner les valeurs.
# Ne jamais committer .env.local ni utiliser le préfixe NEXT_PUBLIC_ pour ces variables.

# Conserver la connexion PostgreSQL déjà utilisée par Prisma (appliquer les migrations avant le déploiement).
DATABASE_URL=

# Clé API Resend avec la permission d’envoyer des e-mails.
RESEND_API_KEY=

# Adresse d’expédition sur un domaine vérifié dans Resend.
# Exemple de format : Terre Viva Paysage <notifications@votre-domaine-verifie.fr>
RESEND_FROM_EMAIL=

# Destinataire fixe dans le serveur : contact@terrepaysage.com
# reply_to : adresse du client validée par POST /api/contact.
# Sans configuration Resend, la demande reste enregistrée et le formulaire signale
# que la notification a échoué. Aucun renvoi automatique et aucune suppression du contact.
